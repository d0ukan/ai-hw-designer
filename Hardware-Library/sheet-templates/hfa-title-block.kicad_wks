(kicad_wks (version 20220228) (generator pl_editor)
  (setup (textsize 1.5 1.5) (linewidth 0.15) (textlinewidth 0.15)
    (left_margin 10) (right_margin 10) (top_margin 10) (bottom_margin 10))
  (rect (name "") (start 0 0 ltcorner) (end 0 0) (comment "Sheet border"))
  (rect (name "") (start 120 38) (end 0 0) (linewidth 0.3) (comment "Title block frame"))
  (line (name "") (start 120 30) (end 0 30))
  (line (name "") (start 120 24) (end 0 24))
  (line (name "") (start 120 18) (end 0 18))
  (line (name "") (start 120 12) (end 0 12))
  (line (name "") (start 120 6) (end 0 6))
  (line (name "") (start 60 24) (end 60 0))
  (tbtext "${TITLE}" (name "") (pos 118 34) (font (size 2.5 2.5) bold) (justify left) (comment "Project name"))
  (tbtext "Sheet name: ${SHEETNAME}" (name "") (pos 118 27) (justify left))
  (tbtext "Code: ${COMMENT1}" (name "") (pos 118 21) (justify left))
  (tbtext "Variant: ${COMMENT2}" (name "") (pos 58 21) (justify left))
  (tbtext "Revision: ${REVISION}" (name "") (pos 118 15) (justify left))
  (tbtext "Sheet: ${#}/${##}" (name "") (pos 58 15) (justify left))
  (tbtext "Designed: ${COMMENT3}" (name "") (pos 118 9) (justify left))
  (tbtext "Checked: ${COMMENT4}" (name "") (pos 58 9) (justify left))
  (tbtext "Date: ${ISSUE_DATE}" (name "") (pos 118 3) (justify left))
  (tbtext "${COMPANY}" (name "") (pos 58 3) (justify left))
)
